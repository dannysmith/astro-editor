{
  "name": "astro-editor-website",
  "description": "Documentation website for Astro Editor",
  "version": "0.0.1",
  "private": true,
  "author": "Danny Smith",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && bun run lint && bun run format:check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "video": "node video/render.mjs && node video/synth.mjs && node video/publish.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "astro": "^7.3.6",
    "astro-auto-import": "^0.6.0",
    "sharp": "^0.35.5",
    "starlight-kbd": "^0.4.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-page-actions": "^0.7.1",
    "starlight-theme-flexoki": "^0.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
