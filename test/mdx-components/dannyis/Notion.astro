---
import { fetchLinkPreview } from '@utils/linkPreview/index'
import { Icon } from 'astro-icon/components'

export interface Props {
  href: string
  title?: string // Allow manual title override
}

const { href, title: manualTitle } = Astro.props

// Variables with defaults
let title = manualTitle || 'Notion Page'
let hasFavicon = false
let faviconImageURL = ''
let emoji = ''

// Only fetch if no manual title provided. fetchLinkPreview never throws — an
// unreachable or blocked page just leaves the defaults in place.
if (!manualTitle) {
  const meta = await fetchLinkPreview(href)
  title = meta.title || 'Notion Page'

  // Clean title
  if (title?.endsWith('| Notion')) {
    title = title.slice(0, title.lastIndexOf('| Notion')).trim()
  }

  // Get faviconImageURL or emoji. Notion encodes a page's emoji into the icon
  // URL itself, so the declared URL matters here, not our copy of the image.
  const faviconURL = meta.faviconUrl

  // Only our own copy is ever rendered; with no copy the Notion glyph is a
  // better answer than hotlinking someone's S3 bucket from every page view.
  if (meta.favicon && faviconURL?.includes('amazonaws.com')) {
    hasFavicon = true
    faviconImageURL = meta.favicon.src
  } else {
    // Notion encodes emoji icons into the favicon URL, so a malformed percent
    // sequence would otherwise throw where a missing emoji is the right answer.
    let decodedURL: string
    try {
      decodedURL = decodeURIComponent(faviconURL || '')
    } catch {
      decodedURL = faviconURL || ''
    }

    // Regex pattern to match most common emojis
    const emojiRegex =
      /(\p{Emoji_Presentation}|\p{Emoji}\uFE0F|\u200D|\uFE0E|\uFE0F|\p{Extended_Pictographic})/gu

    const matches = decodedURL.match(emojiRegex)

    if (matches) {
      hasFavicon = true
      emoji = matches[0]
    }
  }
}
---

<a class="notion-link" href={href} target="_blank" rel="noopener noreferrer">
  <span class="notion-icon">
    {!hasFavicon && <Icon name="social/notion" />}
    {
      hasFavicon && faviconImageURL && (
        <img
          class="icon-image"
          src={faviconImageURL}
          width="16"
          height="16"
          alt="Notion page icon"
          loading="lazy"
          decoding="async"
        />
      )
    }
    {hasFavicon && emoji && <span class="icon-emoji">{emoji}</span>}
    <svg class="icon-arrow" viewBox="0 0 13 13" aria-hidden="true">
      <path
        d="M6.30826 4.43292L1.76184 8.98454C1.76176 8.98462 1.76169 8.9847 1.76161 8.98477C1.76158 8.9848 1.76156 8.98482 1.76154 8.98484C1.46068 9.28584 1.25 9.6914 1.25 10.1565C1.25 10.6117 1.45865 11.0119 1.73417 11.2886C2.01014 11.5658 2.41107 11.7773 2.87078 11.7773C3.34169 11.7773 3.73758 11.5617 4.03477 11.2733L4.03482 11.2734L4.04244 11.2657L8.58864 6.72474V8.667C8.58864 9.51956 9.22729 10.2935 10.1521 10.2935C11.0528 10.2935 11.75 9.54534 11.75 8.66127V2.92671C11.75 2.48722 11.5981 2.06381 11.2838 1.74808C10.9689 1.43182 10.5446 1.27728 10.1006 1.27728H4.36028C3.46161 1.27728 2.72804 1.97749 2.72804 2.86942C2.72804 3.79734 3.51104 4.43292 4.35455 4.43292H6.30826Z"
      ></path>
    </svg>
  </span>
  {title}
</a>

<style>
  .notion-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    margin-inline: 0.1em;
  }

  .notion-icon {
    position: relative;
    font-size: 0.8em;
    width: 1em;
    height: 1em;
    transform: translateY(0.1em);

    &:has(.icon-image) {
      width: 1.25em;
      height: 1.25em;
      transform: translateY(0.3em);
    }
  }

  .icon-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-xs);
  }

  .icon-emoji {
    display: inline-block;
    line-height: 1;
    position: absolute;
    inset-block-end: 0;
  }

  /* External arrow indicator positioned at corner of icon */
  .icon-arrow {
    position: absolute;
    inset-inline-end: -0.2em;
    inset-block-end: -0.08em;
    width: 0.65em;
    height: 0.65em;
    fill: currentColor;
    stroke: var(--color-background);
    stroke-width: 1.5;
    opacity: 0.7;
  }
</style>
