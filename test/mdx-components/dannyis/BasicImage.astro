---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  src: string
  height?: number
  width?: number
  bleed?: 'left' | 'right' | 'full'
  alt?: string
  showAlt?: boolean
  caption?: string
  sourceUrl?: string
  sourceTitle?: string
  framed?: boolean
}

const {
  src,
  height,
  width,
  bleed = null,
  alt = '',
  showAlt = false,
  caption,
  sourceUrl,
  sourceTitle,
  framed = false,
} = Astro.props

// A caption (explicit prop, or markdown image title) takes precedence over the
// alt text. `showAlt` falls back to rendering the alt as the caption.
const captionText = caption || (showAlt ? alt : '')
const showCaption = Boolean(captionText)

// Use glob import to get all images
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*')

// Handle both "/src/assets" (from content editors) and "/assets" paths
const imageSrc =
  typeof src === 'string' && src.startsWith('/src/assets')
    ? (await images[src]()).default
    : typeof src === 'string' && src.startsWith('/assets')
      ? (await images['/src' + src]()).default
      : src

const isGif = typeof src === 'string' && src.toLowerCase().endsWith('.gif')

// For remote images without dimensions, provide reasonable defaults to prevent build errors
const isRemoteImage =
  typeof src === 'string' && (src.startsWith('http') || src.startsWith('/uploads'))
const defaultWidth = width || (isRemoteImage ? 800 : undefined)
const defaultHeight = height || (isRemoteImage ? 400 : undefined)

// Match the actual rendered width so browsers pick a sensibly-sized variant.
// Prose column caps at --measure-standard (70ch ≈ 700px); bleeds span wider.
const sizes =
  bleed === 'full'
    ? '100vw'
    : bleed === 'left' || bleed === 'right'
      ? '(min-width: 1024px) 1000px, 100vw'
      : '(min-width: 768px) 700px, 100vw'
---

<figure
  class:list={[
    'figure',
    { framed },
    { 'bleed-left': bleed === 'left' },
    { 'bleed-right': bleed === 'right' },
    { 'bleed-full': bleed === 'full' },
  ]}
>
  <div class:list={['image-wrapper']}>
    {
      isGif ? (
        <img
          src={typeof imageSrc === 'string' ? src : imageSrc.src}
          alt={alt}
          height={defaultHeight}
          width={defaultWidth}
          loading="lazy"
        />
      ) : (
        <Picture
          src={imageSrc as ImageMetadata}
          alt={alt}
          formats={['avif', 'webp', 'jpg']}
          fallbackFormat="jpg"
          sizes={sizes}
          height={defaultHeight}
          width={defaultWidth}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>
  {
    showCaption &&
      (sourceUrl ? (
        <figcaption>
          {captionText} (source: <a href={sourceUrl}>{sourceTitle}</a>)
        </figcaption>
      ) : (
        <figcaption>{captionText}</figcaption>
      ))
  }
</figure>

<style>
  .figure {
    grid-column: 2 / 3 !important;
    border-radius: var(--radius-xs);
    text-align: center;
    margin-inline: auto;
    overflow: hidden;

    figcaption {
      padding: var(--space-2xs) var(--space-xs);
      font-size: var(--font-size-sm);
    }

    &.framed {
      border: var(--border-width-hairline) solid var(--color-accent);

      figcaption {
        border-top: var(--border-width-hairline) solid var(--color-accent);
      }
    }

    &.bleed-left {
      grid-column: 1 / 3 !important;
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }

    &.bleed-right {
      grid-column: 2 / 4 !important;
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
    }

    &.bleed-full {
      grid-column: 1 / 4 !important;
      border-radius: 0;
    }
  }

  /* Inline-block shrink-wraps the image so the ::before placeholder
     never exceeds image dimensions */
  .image-wrapper {
    display: inline-block;
    vertical-align: top; /* Removes baseline gap inside framed figures */
  }
</style>
