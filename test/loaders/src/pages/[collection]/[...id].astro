---
// A page for each entry of a Markdown or MDX collection
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Layout from '../../layouts/Layout.astro'
import { label, references, renderable } from '../../lib/collections'
import Callout from '../../components/mdx/Callout.astro'
import Figure from '../../components/mdx/Figure.astro'
import YouTube from '../../components/mdx/YouTube.astro'
import ApiTable from '../../components/docs/ApiTable.astro'
import Steps from '../../components/docs/Steps.astro'
import Tip from '../../components/docs/Tip.astro'

export async function getStaticPaths() {
  const collections = await Promise.all(renderable.map(name => getCollection(name)))
  return collections.flat().map(entry => ({
    params: { collection: entry.collection, id: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const data = entry.data as Record<string, unknown>
const cover = data.cover as ImageMetadata | undefined
const refs = await references(entry)
---

<Layout title={label(entry)}>
  <p><a href="/">All collections</a> / {entry.collection}</p>
  <h1>{label(entry)}</h1>
  <p><code>{entry.id}</code> from <code>{entry.filePath}</code></p>
  {refs.length > 0 && <p>{refs.join(', ')}</p>}
  {cover && <Image src={cover} alt={String(data.coverAlt ?? '')} />}
  <Content components={{ Callout, Figure, YouTube, ApiTable, Steps, Tip }} />
</Layout>
