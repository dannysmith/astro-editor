---
interface Props {
  title: string
}

const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      body {
        font-family: system-ui, sans-serif;
        max-width: 50rem;
        margin: 2rem auto;
        padding: 0 1rem;
        line-height: 1.5;
      }
      img {
        max-width: 100%;
        height: auto;
      }
      code {
        font-size: 0.85em;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
