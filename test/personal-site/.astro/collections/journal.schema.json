{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "mood": {
      "type": "string",
      "enum": [
        "good",
        "okay",
        "rough"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "date"
  ]
}