---
/**
 * A book with its cover and your rating, for reading lists and recommendations.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  /** The book's title */
  title: string;
  author: string;
  cover: ImageMetadata;
  format?: 'hardback' | 'paperback' | 'ebook' | 'audiobook';
  /** Out of five */
  rating?: number;
  finished?: Date;
  favourite: boolean;
  spoilers?: boolean;
  tags?: string[];
  /** Your full review, linked from the card */
  review?: CollectionEntry<'books'>;
}

const { title, author, cover, format = 'paperback', rating, favourite, review } = Astro.props;
---

<article class:list={['book-card', { favourite }]}>
  <Image src={cover} alt={`The cover of ${title}`} width={160} />
  <h3>{title}</h3>
  <p>{author} · {format}{rating && ` · ${rating}/5`}</p>
  <slot />
  {review && <a href={`/books/${review.id}`}>Read my review</a>}
</article>
