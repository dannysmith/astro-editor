{
  "name": "astro-editor",
  "private": true,
  "version": "1.0.20",
  "type": "module",
  "author": "Danny Smith",
  "description": "Astro Editor is a native macOS application designed specifically for editing Astro content collections. It provides a distraction-free writing environment with seamless frontmatter editing capabilities. It also provides a component builder for MDX files, and a number of writing modes to help you write.",
  "homepage": "https://github.com/dannysmith/astro-editor",
  "copyright": "Copyright © 2025 Danny Smith. All rights reserved.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dannysmith/astro-editor.git"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "lint:fix": "oxlint --fix",
    "ast:lint": "ast-grep scan",
    "ast:fix": "ast-grep scan --update-all",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt --check",
    "rust:clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "rust:clippy:fix": "cd src-tauri && cargo clippy --all-targets --fix --allow-dirty",
    "rust:test": "cd src-tauri && cargo test",
    "tauri": "tauri",
    "app": "bun scripts/app.ts",
    "tauri:dev": "scripts/tauri-dev.sh",
    "tauri:build": "bun run tauri build",
    "tauri:check": "bun run typecheck && bun run rust:clippy",
    "test:all": "bun run test:run && bun run rust:test",
    "check:all": "bun run typecheck && bun run lint && bun run ast:lint && bun run format:check && bun run rust:fmt:check && bun run rust:clippy && bun run test:run && bun run rust:test",
    "fix:all": "bun run lint:fix && bun run ast:fix && bun run format && bun run rust:fmt && bun run rust:clippy:fix",
    "reset:testdata": "rm -rf temp-dummy-astro-project && cp -r test/dummy-astro-project temp-dummy-astro-project",
    "prepare-release": "node scripts/prepare-release.js",
    "test-build": "node scripts/test-build.js",
    "knip": "knip",
    "jscpd": "jscpd src src-tauri/src",
    "stats": "cd telemetry-worker && bun run stats && cd .."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compromise": "^14.19.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-resizable-panels": "^4.14.8",
    "react-textarea-autosize": "^8.5.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "~1.0.0",
    "baseline-browser-mapping": "^2.11.30",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "@lezer/common": "^1.5.0"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
