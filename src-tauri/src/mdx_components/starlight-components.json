          "name": "title",
          "prop_type": "string",
          "kind": {
            "kind": "string"
          },
          "is_optional": true,
          "default_value": null,
          "description": "The code block's title. For terminal frames, this is displayed as the terminal window title,\nand for code frames, it's displayed as the file name in an open file tab.\n\nIf no title is given, the plugin will try to automatically extract a title from a\n[file name comment](https://expressive-code.com/key-features/frames/#file-name-comments)\ninside your code, unless disabled by the `extractFileNameFromCode` option."
        },
        {
          "name": "frame",
          "prop_type": "'code' | 'terminal' | 'none' | 'auto'",
          "kind": {
            "kind": "literals",
            "values": ["code", "terminal", "none", "auto"]
          },
          "is_optional": true,
          "default_value": null,
          "description": "Allows you to override the automatic frame type detection for a code block.\n\nThe supported values are `code`, `terminal`, `none` and `auto`."
        },
        {
          "name": "wrap",
          "prop_type": "boolean",
          "kind": {
            "kind": "boolean"
          },
          "is_optional": true,
          "default_value": null,
          "description": "If `true`, word wrapping will be enabled for the code block, causing lines that exceed\nthe available width to wrap to the next line. You can use the `preserveIndent` option\nto control how wrapped lines are indented.\n\nIf `false`, lines that exceed the available width will cause a horizontal scrollbar\nto appear."
        }
      ],
      "has_slot": false,
      "description": "A code block from a string, for code that a fenced block can’t hold.",
